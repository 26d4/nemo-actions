[Nemo Action]
Name=Shellcheck
Exec=bash -c 'if shellcheck %F; then notify-send -e Shellcheck OK; else read -N1; fi'
Selection=s

Extensions=sh;
Mimetypes=application/x-shellscript;

Comment=Shell script analysis
Icon-Name=category-search-symbolic
Quote=double
Dependencies=shellcheck;notify-send;
Terminal=true
